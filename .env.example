# Локально — sqlite, в продакшене — postgres (см. prisma/schema.postgres.prisma)
DATABASE_URL="file:./dev.db"

# Сгенерируй: openssl rand -base64 32
AUTH_SECRET=

# https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Уведомления о заявках с лендингов в Telegram (создай бота через @BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Базовый URL для sitemap и og-тегов, например https://landing-builder.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Нужен на проде (vercel) для корректной работы next-auth
AUTH_TRUST_HOST=true

# На проде — адрес деплоя, чтобы next-auth не путал origin
AUTH_URL=http://localhost:3000

# Лимиты бесплатного плана (можно менять)
SITES_LIMIT=3
GENERATIONS_LIMIT_DAY=10
